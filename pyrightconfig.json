{
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.12",
    "typeCheckingMode": "basic",
    "exclude": [
        ".venv",
        "venv",
        "env",
        ".env",
        "**/__pyrefly_virtual__",
        "**/site-packages/**"
    ],
    "ignore": [
        ".venv",
        "venv",
        "env",
        ".env"
    ],
    "reportMissingModuleSource": "none",
    "reportMissingImports": "none",
    "reportMissingTypeStubs": "none"
}
